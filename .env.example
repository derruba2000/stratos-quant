# Absolute path to your existing SQLite portfolio database file
SQLITE_DB_PATH=/absolute/path/to/portfolio_management.sqlite3

# Ollama model used by local inference calls
OLLAMA_MODEL=llama3

# Local Ollama API endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Request timeout for slower local models, in seconds
OLLAMA_TIMEOUT_SECONDS=300
